# Template env — copy ke `.env.local` (gitignored), isi value asli di sana.
# JANGAN commit secret asli ke .env.example (file ini di-track di git).

# ─── Supabase ───────────────────────────────────────────────────────
# Bikin project di https://supabase.com (free tier OK).
# Project URL & anon key: Settings → API → Project URL + anon public key.
# Service role: Settings → API → service_role secret (server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App config ─────────────────────────────────────────────────────
# Base URL untuk redirect, sitemap, OG canonical. Set ke domain prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Tokopay (payment gateway) ──────────────────────────────────────
# Daftar di https://tokopay.id, copy Merchant ID + Secret.
TOKOPAY_MERCHANT_ID=
TOKOPAY_SECRET=
TOKOPAY_BASE_URL=https://api.tokopay.id/v1

# IP whitelist webhook callback. Comma-separated. Kosongkan = skip
# (dev only). Production WAJIB di-set. Default: 178.128.104.179
TOKOPAY_IP_WHITELIST=178.128.104.179

# ─── Email (Resend) ─────────────────────────────────────────────────
# Optional. Kalau kosong, kredensial cuma muncul di dashboard customer.
# Daftar di https://resend.com (free tier 100 email/hari).
RESEND_API_KEY=
EMAIL_FROM="lapakurab <noreply@yourdomain.com>"

# ─── Cron auth ──────────────────────────────────────────────────────
# Rahasia random untuk proteksi /api/cron/*. Generate:
#   openssl rand -hex 32  (atau pakai PowerShell/Node helper)
CRON_SECRET=

# ─── Rate limiter (Upstash Redis) ───────────────────────────────────
# WAJIB di production. Tanpa ini, rate limit FAIL-OPEN. Project akan
# refuse start kalau NODE_ENV=production tanpa env ini di-set.
# Daftar di https://upstash.com (free 10k req/hari).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (error tracking) ────────────────────────────────────────
# RECOMMENDED untuk production. Free tier 5k events/bulan.
# Buat project di https://sentry.io → copy DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
