# Ensure cross-platform line ending consistency.
# Shell scripts MUST be LF on Linux/macOS — CRLF causes "command not found" errors.

# Default: auto-detect text vs binary, normalize to LF in repo
* text=auto eol=lf

# Force LF for files that run on Linux VPS / Unix systems
*.sh        text eol=lf
*.bash      text eol=lf
Caddyfile   text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env*       text eol=lf

# Force CRLF for Windows-only files (none currently)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary (no normalization)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
